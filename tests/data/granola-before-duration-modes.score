1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":2,"Hidden":true,"Custom":"Position Deviation","Exposed":"position deviation","Description":"How far each grain's start strays at random around Position, 0 for none.","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":3,"Hidden":true,"Custom":"Scan","Exposed":"scan","Description":"Moves Position through the sound by itself: 1 at the sound's own speed, negative backwards, 0 to stay.","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":-2.0,"Max":2.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":4,"Hidden":true,"Custom":"Duration","Exposed":"duration","Description":"How long each grain is, as a part of the region, from almost nothing to all of it (1).","Value":{"Float":0.20000000298023224},"Init":{"Float":0.10000000149011612},"Domain":{"Float":{"Min":9.99999993922529e-9,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":5,"Hidden":true,"Custom":"Duration Deviation","Exposed":"duration deviation","Description":"How much the length of each grain varies at random around Duration, 0 for none.","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":6,"Hidden":true,"Custom":"Spread","Exposed":"spread","Description":"Where grains sit among the outputs: 0 in all alike, 1 panned between two neighbours, 2 in a single one.","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":2.0}}},{"uuid":"4e43c108-4972-44ca-8d75-5804ca072fe2","ObjectName":"Inlet","id":7,"Hidden":true,"Custom":"Pitch","Exposed":"pitch","Description":"How fast grains read the sound: 1 as recorded, 2 an octave up, 0.5 an octave down.","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":9.999999974752427e-7,"Max":10.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":8,"Hidden":true,"Custom":"Pitch Deviation","Exposed":"pitch deviation","Description":"How much the pitch of each grain varies at random around Pitch, 0 for none.","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":9,"Hidden":true,"Custom":"Pitch Deviation in Semitones","Exposed":"pitch deviation in semitones","Description":"Makes Pitch Deviation pick whole semitones instead of any pitch in between.","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}},{"uuid":"4e43c108-4972-44ca-8075-5804ca072fe2","ObjectName":"Inlet","id":10,"Hidden":true,"Custom":"Density","Exposed":"density","Description":"How often grains start: 1 starts one as the last one ends, 2 twice as often, 0 none.","Value":{"Float":2.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":256.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":11,"Hidden":true,"Custom":"Density Deviation","Exposed":"density deviation","Description":"How irregular the time between grains is, 0 for a steady pulse.","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":12,"Hidden":true,"Custom":"Reverse Chance","Exposed":"reverse chance","Description":"How likely each grain is to play backwards, from never (0) to always (1).","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":13,"Hidden":true,"Custom":"Gain","Exposed":"gain","Description":"The output level, 1 as loud as the sound itself.","Value":{"Float":0.5},"Init":{"Float":0.5},"Domain":{"Float":{"Min":0.0,"Max":4.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":14,"Hidden":true,"Custom":"Gain Deviation","Exposed":"gain deviation","Description":"How much quieter some grains are at random, down to -24 dB at 1, never louder.","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"8093743c-584f-4bb9-97d4-6c7602f87116","ObjectName":"Inlet","id":15,"Hidden":true,"Custom":"Window coefs","Exposed":"window coefs","Description":"The fade in and out of each grain: up for a sharper peak, left or right to move it earlier or later.","Value":{"Vec2f":[0.5,0.05000000074505806]},"Init":{"Vec2f":[0.5,0.05000000074505806]},"Domain":{"Vec2f":{"Min":[0.0,0.0],"Max":[1.0,1.0],"Values":[[],[]]}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":16,"Hidden":true,"Custom":"Interpolation mode","Exposed":"interpolation mode","Description":"How the sound is read between its samples: None is grittier, Linear smoother, Cubic smoothest.","Value":{"Int":2},"Init":{"Int":2},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["None",{"Int":0}],["Linear",{"Int":1}],["Cubic",{"Int":2}]],"FolderPort":"","FileExtensions":""},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":17,"Hidden":true,"Custom":"Window mode","Exposed":"window mode","Description":"The family of fade shapes of each grain: Beta, Cos or Kuma.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["Beta",{"Int":0}],["Cos",{"Int":1}],["Kuma",{"Int":2}]],"FolderPort":"","FileExtensions":""},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":18,"Hidden":true,"Custom":"Loop","Exposed":"loop","Description":"Lets a grain that reaches the end of the region go on from its start.","Value":{"Bool":false},"Init":{"Bool":false},"Domain":{"Bool":null}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":19,"Hidden":true,"Custom":"Source Channels","Exposed":"source channels","Description":"How many channels of the sound the grains read, 0 for all of them.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Min":0,"Max":8}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":20,"Hidden":true,"Custom":"Channel Offset","Exposed":"channel offset","Description":"The first channel of the sound the grains read, 0 for the first one.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Min":0,"Max":7}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":21,"Hidden":true,"Custom":"Max Voices","Exposed":"max voices","Description":"The most grains that may play at once, from 0 to 256.","Value":{"Int":128},"Init":{"Int":128},"Domain":{"Int":{"Min":0,"Max":256}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":22,"Hidden":true,"Custom":"Continuous","Exposed":"continuous","Description":"Plays grains by itself, as often as Density says.","Value":{"Bool":true},"Init":{"Bool":true},"Domain":{"Bool":null}},{"uuid":"7cd210d3-ebd1-4f71-9de6-cccfb639cbc3","ObjectName":"Inlet","id":23,"Hidden":true,"Custom":"Trigger","Exposed":"trigger","Description":"Plays one grain each time it is pressed.","Value":{"Impulse":null},"Init":{"Impulse":null},"Domain":{"Impulse":null}},{"uuid":"c18adc77-e0e0-4ddf-a46c-43cb0719a890","ObjectName":"Inlet","id":24,"Hidden":false,"Custom":"MIDI In","Exposed":"midi in","Description":"MIDI notes that play grains, set their pitch or place, or pick the file, as On MIDI and Sound Order say."},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":25,"Hidden":true,"Custom":"On MIDI","Exposed":"on midi","Description":"What MIDI notes do: nothing; play grains while held, at Pitch or at their own pitch; set the pitch or the place of the other grains; or play grains from their own place.","Value":{"Int":2},"Init":{"Int":2},"Domain":{"Int":{"Values":[0,1,2,3,4,5]}},"Values":[["Nothing",{"Int":0}],["Trigger",{"Int":1}],["Trigger and set pitch",{"Int":2}],["Set pitch",{"Int":3}],["Set position",{"Int":4}],["Trigger and set position",{"Int":5}]],"FolderPort":"","FileExtensions":""},{"uuid":"82427d27-084a-4ab6-9c4e-db83929a1200","ObjectName":"Inlet","id":26,"Hidden":true,"Custom":"Velocity","Exposed":"velocity","Description":"How much MIDI velocity sets the level of the grains: 0 ignores it, 1 follows it fully.","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"fb27e4cb-ea7f-41e2-ad92-2354498c1b6b","ObjectName":"Inlet","id":27,"Hidden":true,"Custom":"Keep time","Exposed":"keep time","Description":"Keeps the length of the grains and their pace the same at any pitch.","Value":{"Bool":true},"Init":{"Bool":false},"Domain":{"Bool":null}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":28,"Hidden":true,"Custom":"Source","Exposed":"source","Description":"Where the sound comes from: one sound file, or a folder of them.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1]}},"Values":[["File",{"Int":0}],["Folder",{"Int":1}]],"FolderPort":"","FileExtensions":""},{"uuid":"a866e07f-f380-4f69-8bce-e52682db2025","ObjectName":"Inlet","id":29,"Hidden":true,"Custom":"Sounds","Exposed":"sounds","Description":"The folder of sound files the grains play when Source is Folder.","Value":{"String":""},"Init":{"String":""},"Domain":{}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":30,"Hidden":true,"Custom":"Sound in folder","Exposed":"sound in folder","Description":"The file of the folder that plays, by its name or by its number in the folder.","Value":{"String":"-"},"Init":{"String":"-"},"Domain":{"String":{"Values":["-"]}},"Values":[["-",{"String":"-"}]],"FolderPort":"Sounds","FileExtensions":"*.wav *.w64 *.aif *.aiff *.aifc *.caf *.flac *.mp3 *.ogg *.opus *.m4a"},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":31,"Hidden":true,"Custom":"Sound Order","Exposed":"sound order","Description":"Which file of the folder each grain plays: the picked one, any at random, each once shuffled, in order, back and forth, a neighbour, or the one of the MIDI note.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2,3,4,5,6]}},"Values":[["Single file",{"Int":0}],["Random",{"Int":1}],["Shuffle",{"Int":2}],["Alphabetical",{"Int":3}],["Ping-pong",{"Int":4}],["Random walk",{"Int":5}],["By MIDI note",{"Int":6}]],"FolderPort":"","FileExtensions":""},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":32,"Hidden":true,"Custom":"Scan in folder","Exposed":"scan in folder","Description":"With a folder, where Scan goes on when another file plays: from Position again, where it was, or where that file was left.","Value":{"Int":0},"Init":{"Int":0},"Domain":{"Int":{"Values":[0,1,2]}},"Values":[["Restart",{"Int":0}],["Continue",{"Int":1}],["Per file",{"Int":2}]],"FolderPort":"","FileExtensions":""},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":33,"Hidden":true,"Custom":"Sample Start","Exposed":"sample start","Description":"Where the part of the sound that plays begins, 0 for the start of the sound.","Value":{"Float":0.0},"Init":{"Float":0.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"af2b4fc3-aecb-4c15-a5aa-1c573a239925","ObjectName":"Inlet","id":34,"Hidden":true,"Custom":"Sample End","Exposed":"sample end","Description":"Where the part of the sound that plays ends, 1 for the end of the sound.","Value":{"Float":1.0},"Init":{"Float":1.0},"Domain":{"Float":{"Min":0.0,"Max":1.0}}},{"uuid":"238399a0-7e81-47e3-896f-08e8856e2973","ObjectName":"Inlet","id":35,"Hidden":true,"Custom":"Output Channels","Exposed":"output channels","Description":"How many outputs the grains are spread over, 0 for as many as the sound channels read.","Value":{"Int":2},"Init":{"Int":2},"Domain":{"Int":{"Min":0,"Max":1024}}},{"uuid":"485680cc-b8b9-4a01-acc7-3e8334bdc016","ObjectName":"Inlet","id":36,"Hidden":true,"Custom":"Scan Mode","Exposed":"scan mode","Description":"What Scan does at the end of the region: Loop starts over, Straight stops there, PingPong turns back.","Value":{"Int":